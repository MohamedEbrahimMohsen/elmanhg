# AI service settings (docs/ai-service.md → Configuration). ELMANHG_AI_ENV is set by compose from .env.
# Replace before deploying: the service refuses the "change-me" example value when ELMANHG_AI_ENV=production.
ELMANHG_AI_SERVICE_TOKEN=change-me-local-ai-service-token-0123456789
# LLM: any OpenAI-compatible Chat Completions API (OpenAI by default; Gemini or DeepSeek by base URL). Fake is the default.
# The model id and prices are placeholders: confirm them against the provider's model list at go-live (docs/ai-service.md).
# Set ELMANHG_AI_LLM_PROVIDER=openai_compatible to go live.
ELMANHG_AI_LLM_PROVIDER=fake
# ELMANHG_AI_LLM_BASE_URL=https://api.openai.com/v1
# ELMANHG_AI_LLM_API_KEY=            # empty: reuse ELMANHG_AI_OPENAI_API_KEY
# ELMANHG_AI_CHAT_MODEL=gpt-5.6-luna
# ELMANHG_AI_LLM_STRUCTURED_OUTPUT=json_schema   # json_object for DeepSeek
# ELMANHG_AI_LLM_MAX_TOKENS_FIELD=max_completion_tokens   # max_tokens for DeepSeek
# ELMANHG_AI_LLM_REASONING_EFFORT=low   # default = do not send
# ELMANHG_AI_MODEL_INPUT_USD_PER_MILLION_TOKENS=0.20
# ELMANHG_AI_MODEL_OUTPUT_USD_PER_MILLION_TOKENS=1.20
# ELMANHG_AI_CHAT_PROMPT_VERSION=v3
# ELMANHG_AI_CHAT_MAX_SOURCES=20
# ELMANHG_AI_CHAT_MAX_SOURCE_CHARS=8000
# ELMANHG_AI_LOG_LEVEL=INFO

# Lesson retrieval embeddings (docs/content-retrieval.md). After switching provider or model, POST /api/content-index/rebuild.
ELMANHG_AI_EMBEDDING_PROVIDER=fake
# ELMANHG_AI_OPENAI_API_KEY=
# ELMANHG_AI_EMBEDDING_MODEL=text-embedding-3-small
# ELMANHG_AI_EMBEDDING_DIMENSIONS=1536
# ELMANHG_AI_EMBEDDING_MAX_TEXTS=64
# ELMANHG_AI_EMBEDDING_MAX_TEXT_CHARS=8000
# ELMANHG_AI_EMBEDDING_USD_PER_MILLION_TOKENS=0.02

# Voice-reply transcription (docs/ai-service.md). openai uses Whisper with ELMANHG_AI_OPENAI_API_KEY.
ELMANHG_AI_TRANSCRIPTION_PROVIDER=fake
# ELMANHG_AI_TRANSCRIPTION_MODEL=whisper-1
# ELMANHG_AI_TRANSCRIPTION_TIMEOUT_SECONDS=60
# ELMANHG_AI_TRANSCRIPTION_MAX_AUDIO_BYTES=10485760
# ELMANHG_AI_TRANSCRIPTION_MAX_DURATION_SECONDS=600
# ELMANHG_AI_TRANSCRIPTION_USD_PER_MINUTE=0.006

# Essay grading (#118, docs/essay-grading.md). Uses the LLM settings above; keep the timeout under the API's AiService__EssayGradingTimeoutSeconds.
# ELMANHG_AI_ESSAY_GRADING_MODEL=gpt-5.6-luna
# ELMANHG_AI_ESSAY_GRADING_TIMEOUT_SECONDS=45
# #122 CAS final answer check (docs/math-cas.md). Keep the timeout well under the API's AiService__MathCheckTimeoutSeconds.
# ELMANHG_AI_CAS_TIMEOUT_SECONDS=5
# ELMANHG_AI_CAS_WORKERS=2
# ELMANHG_AI_CAS_WORKER_MEMORY_MB=1024
# ELMANHG_AI_CAS_MAX_EXPANSION_TERMS=500
# Math step grading (#123, docs/math-step-grading.md). Uses the LLM settings above; keep the timeout under the API's AiService__MathStepGradingTimeoutSeconds.
# ELMANHG_AI_MATH_STEP_GRADING_MODEL=gpt-5.6-luna
# ELMANHG_AI_MATH_STEP_GRADING_TIMEOUT_SECONDS=45

# Telemetry (docs/observability.md). The endpoint and service version are set by compose from .env; headers only for a SaaS endpoint (secret).
# ELMANHG_AI_OTLP_HEADERS=authorization=Bearer <token>
# ELMANHG_AI_TRACE_SAMPLE_RATIO=1.0
