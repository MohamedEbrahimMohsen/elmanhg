# AI service settings (docs/ai-service.md → Configuration). ELMANHG_AI_ENV is set by compose from .env.
ELMANHG_AI_SERVICE_TOKEN=change-me-local-ai-service-token-0123456789
ELMANHG_AI_LLM_PROVIDER=fake
# ELMANHG_AI_ANTHROPIC_API_KEY=
# ELMANHG_AI_CHAT_MODEL=claude-sonnet-5
# ELMANHG_AI_LOG_LEVEL=INFO

# Lesson retrieval embeddings (docs/content-retrieval.md). After switching provider or model, POST /api/content-index/rebuild.
ELMANHG_AI_EMBEDDING_PROVIDER=fake
# ELMANHG_AI_OPENAI_API_KEY=
# ELMANHG_AI_EMBEDDING_MODEL=text-embedding-3-small
# ELMANHG_AI_EMBEDDING_DIMENSIONS=1536
# ELMANHG_AI_EMBEDDING_MAX_TEXTS=64
# ELMANHG_AI_EMBEDDING_MAX_TEXT_CHARS=8000
# ELMANHG_AI_EMBEDDING_USD_PER_MILLION_TOKENS=0.02
