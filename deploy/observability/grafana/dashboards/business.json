{
  "uid": "elmanhg-business",
  "title": "Elmanhg · Business activity",
  "description": "Quiz answers, payments, OTP sends, AI calls and cost, and browser errors.",
  "tags": [
    "elmanhg"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Quiz answers/min by outcome",
      "description": "Graded answers per minute by outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (elmanhg_outcome) (rate(elmanhg_quiz_answers_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "{{elmanhg_outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Quiz answers",
      "description": "Answers submitted in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(elmanhg_quiz_answers_total[$__range]))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Payment notifications by outcome",
      "description": "Paymob notifications by processing outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (elmanhg_outcome) (increase(elmanhg_payment_notifications_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{elmanhg_outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Checkouts and refunds",
      "description": "Checkout and refund requests by outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (elmanhg_request, elmanhg_outcome) (increase(elmanhg_requests_total{elmanhg_request=~\"StartCheckoutCommand|RefundPaymentCommand\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{elmanhg_request}} {{elmanhg_outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "OTP sends by channel",
      "description": "OTP messages by channel and delivery outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (elmanhg_channel, elmanhg_outcome) (increase(elmanhg_otp_sends_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{elmanhg_channel}} {{elmanhg_outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "AI calls",
      "description": "Model and embedding calls by operation and error type.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_operation_name, error_type) (increase(gen_ai_client_operation_duration_seconds_count[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{gen_ai_operation_name}} {{error_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "AI tokens",
      "description": "Input and output tokens by operation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_operation_name, gen_ai_token_type) (increase(gen_ai_client_token_usage_sum[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{gen_ai_operation_name}} {{gen_ai_token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "AI cost (USD)",
      "description": "Estimated model spend in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(elmanhg_ai_cost_total[$__range]))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "AI p95 by operation",
      "description": "95th percentile model call duration by operation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_operation_name) (rate(gen_ai_client_operation_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{gen_ai_operation_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Browser errors by source",
      "description": "Errors reported by the web app through POST /api/client-errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (elmanhg_source) (increase(elmanhg_client_errors_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{elmanhg_source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
