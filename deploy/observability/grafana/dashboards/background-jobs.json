{
  "uid": "elmanhg-background-jobs",
  "title": "Elmanhg · Background jobs",
  "description": "Sweeps of the exam auto-submit, subscription lapse and lesson index workers.",
  "tags": [
    "elmanhg"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(elmanhg_job_interval_seconds, elmanhg_job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(elmanhg_job_interval_seconds, elmanhg_job)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Since last success",
      "description": "Seconds since each job last completed a sweep that listed its work.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - elmanhg_job_last_success_seconds{elmanhg_job=~\"$job\"}",
          "refId": "A",
          "legendFormat": "{{elmanhg_job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Stale after",
      "description": "The BackgroundJobStale alert fires past 3 sweep intervals.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "3 * elmanhg_job_interval_seconds{elmanhg_job=~\"$job\"}",
          "refId": "A",
          "legendFormat": "{{elmanhg_job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Runs by outcome",
      "description": "Completed sweeps by outcome: Succeeded, PartiallyFailed (some items failed) or Failed (listing failed).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (elmanhg_job, elmanhg_outcome) (increase(elmanhg_job_runs_total{elmanhg_job=~\"$job\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{elmanhg_job}} {{elmanhg_outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Items succeeded and failed",
      "description": "Items processed per sweep window by outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (elmanhg_job, elmanhg_outcome) (increase(elmanhg_job_items_total{elmanhg_job=~\"$job\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{elmanhg_job}} {{elmanhg_outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sweep p95",
      "description": "95th percentile duration of one sweep.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, elmanhg_job) (rate(elmanhg_job_duration_seconds_bucket{elmanhg_job=~\"$job\"}[15m])))",
          "refId": "A",
          "legendFormat": "{{elmanhg_job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Worker logs",
      "description": "API log lines written by the background workers.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"elmanhg-api\"} |~ \"Elmanhg\\\\.Api\\\\.Workers\"",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
