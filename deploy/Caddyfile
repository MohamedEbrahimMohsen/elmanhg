# Edge for one environment (docs/deployment.md). SITE_ADDRESS is the public host name
# (automatic HTTPS through Let's Encrypt), or ":80" for plain HTTP in the smoke test.

# The default logger carries http.log.error.* entries, which hold the full request; filter it like the access log (docs/observability.md, PII rules).
{
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>uri regexp `\?.*$` "?redacted"
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
			}
		}
	}
}

# Response headers on every edge response (docs/security.md §4); defer applies them when the response is written, so proxied API responses get them too.
(security_headers) {
	header {
		defer
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

# The API logs CF-* headers as the client location; no Cloudflare sits in front, so clients must not be able to set them (docs/security.md §4).
(api_proxy) {
	reverse_proxy api:8080 {
		header_up -CF-Connecting-IP
		header_up -CF-IPCountry
		header_up -CF-IPCity
		header_up -CF-Region
		header_up -CF-Region-Code
		header_up -CF-Timezone
	}
}

# Public, body-only health for external uptime monitors (docs/observability.md).
(api_health) {
	handle /api/health {
		rewrite * /health
		import api_proxy
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	import security_headers

	# JSON access log on stdout without headers or query strings, client IPs cut to /24 or /48 (docs/observability.md, PII rules).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>uri regexp `\?.*$` "?redacted"
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
			}
		}
	}

	import api_health

	handle /api/* {
		header Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; frame-ancestors 'none'"
		header ?Cache-Control "no-store"
		import api_proxy
	}

	handle {
		root * /srv
		# MEDIA_ORIGIN (.env) is empty unless FileStorage__PublicBaseUrl serves media from another origin (docs/security.md §4).
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$MEDIA_ORIGIN}; media-src 'self' data: blob: {$MEDIA_ORIGIN}; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		# npm run build writes .br and .gz next to every text asset (docs/performance.md); Caddy cannot brotli on the fly.
		file_server {
			precompressed br gzip
		}
	}
}

# Container-internal health endpoint for the compose health check; the port is not published.
:2080 {
	import api_health
	respond /healthz "ok" 200
}
