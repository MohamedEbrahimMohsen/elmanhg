# API settings for ONE environment. Copy to api.env, chmod 600; never commit it (docs/deployment.md).

# Identity (docs/deployment.md, Configuration and secrets). Key: openssl rand -base64 48; Secret: openssl rand -hex 32.
CoreJwt__Issuer=Elmanhg
CoreJwt__Audience=Elmanhg.Audience
CoreJwt__Key=change-me-openssl-rand-base64-48
CoreOtp__Secret=change-me-openssl-rand-hex-32

# Training data (docs/training-data.md). openssl rand -hex 32; set once, never rotate.
TrainingData__StudentIdHashKey=change-me-openssl-rand-hex-32-placeholder

# Admin seed (docs/deployment.md, First-time host setup): created on first start, then ignored.
AdminSeed__Email=admin@example.com
AdminSeed__Password=change-me-Admin1
AdminSeed__DisplayName=Admin

# Logging (docs/deployment.md, Health checks).
CoreLogging__Trace__Cluster=production

# OTP delivery (docs/otp-delivery.md). A staging host needs a real channel: the fake logs codes in Development only.
# OtpDelivery__DefaultPhoneChannel=WhatsApp
# OtpDelivery__WhatsApp__Provider=Meta
# OtpDelivery__WhatsApp__PhoneNumberId=
# OtpDelivery__WhatsApp__AccessToken=
# OtpDelivery__WhatsApp__TemplateName=
# OtpDelivery__Email__Provider=Resend
# OtpDelivery__Email__ApiKey=
# OtpDelivery__Email__FromAddress=
# OtpDelivery__Sms__Enabled=true
# OtpDelivery__Sms__Provider=Http
# OtpDelivery__Sms__Url=
# OtpDelivery__Sms__AuthHeaderName=
# OtpDelivery__Sms__AuthHeaderValue=
# OtpDelivery__Sms__BodyTemplate=

# Payments (docs/paymob.md). The fake refuses outside Development unless AllowFakePayments=true; Production always refuses it.
Payments__Provider=Fake
Payments__AllowFakePayments=false
# Payments__Provider=Paymob
# Payments__Paymob__SecretKey=
# Payments__Paymob__PublicKey=
# Payments__Paymob__IntegrationIds__0=
# Payments__Paymob__IntegrationIds__1=
# Payments__Paymob__RedirectionUrl=https://<SITE_ADDRESS>/student/checkout-result
# Payments__Paymob__NotificationUrl=https://<SITE_ADDRESS>/api/payments/paymob/webhook
# Payments__Paymob__HmacSecret=

# AI service (docs/ai-service.md): same value as ELMANHG_AI_SERVICE_TOKEN in ai.env; AiService__BaseUrl is set by compose.
AiService__Provider=Http
AiService__ServiceToken=change-me-local-ai-service-token-0123456789

# Lesson content retrieval (docs/content-retrieval.md). Defaults suit every host; the sweep needs the ai profile when AiService__Provider=Http.
# ContentRetrieval__IndexSweepEnabled=true
# ContentRetrieval__IndexSweepIntervalSeconds=30
# ContentRetrieval__IndexSweepBatchSize=20
# ContentRetrieval__ChunkMaxCharacters=1500
# ContentRetrieval__EmbeddingBatchSize=32
# ContentRetrieval__DefaultTopK=5
# ContentRetrieval__MaxTopK=20
# ContentRetrieval__QueryMaxLength=2000

# AI Avatar (docs/avatar.md). Defaults suit every host; the upper bounds are the ai service limits.
# Avatar__MessageMaxLength=2000
# Avatar__HistoryTurnMaxLength=4000
# Avatar__MaxHistoryMessages=10
# Avatar__ContextFieldMaxLength=8000
# Avatar__AdminConversationsMaxPageSize=100
# Avatar__ConversationSearchMaxLength=200

# Ask a Teacher (docs/ask-teacher.md). Defaults suit every host; photos and voice replies are private files under teacher-threads/.
# AskTeacher__QuestionTextMaxLength=2000
# AskTeacher__ImageMaxSizeInMb=5
# AskTeacher__ThreadListMaxPageSize=50
# AskTeacher__ReplyTextMaxLength=4000
# Subscriptions__AskTeacherMonthlyQuestions=20
# Subscriptions__AskTeacherReplySlaHours=24
# Voice replies: the transcription worker needs the ai profile when AiService__Provider=Http.
# AskTeacher__VoiceMaxSizeInMb=5
# AskTeacher__VoiceMaxDurationSeconds=180
# AskTeacher__TranscriptionLanguage=ar
# AskTeacher__TranscriptionSweepEnabled=true
# AskTeacher__TranscriptionSweepIntervalSeconds=5
# AskTeacher__TranscriptionSweepBatchSize=5
# AskTeacher__TranscriptionMaxAttempts=4
# AskTeacher__TranscriptionRetryBaseDelaySeconds=15
# AiService__TranscriptionTimeoutSeconds=150
# SLA reminders and breaches: the ask-teacher-sla worker reminds in-app at 12 h and 20 h into each reply window.
# AskTeacher__SlaSweepEnabled=true
# AskTeacher__SlaSweepIntervalSeconds=60
# AskTeacher__SlaSweepBatchSize=50
# AskTeacher__FirstReminderAfterHours=12
# AskTeacher__SecondReminderAfterHours=20
# AskTeacher__ReminderListMaxCount=20

# Essay grading (#118, docs/essay-grading.md): the essay-grading worker grades essays through the ai service; below the threshold a teacher reviews.
# EssayGrading__SweepEnabled=true
# EssayGrading__ReviewConfidenceThreshold=0.7
# AiService__EssayGradingTimeoutSeconds=100

# Training data export (#110, docs/training-data.md): the training-export worker writes JSONL files under training-exports/; the retention worker deletes them after RetentionDays.
# TrainingExports__SweepEnabled=true
# TrainingExports__SweepIntervalSeconds=15
# TrainingExports__SweepBatchSize=2
# TrainingExports__MaxAttempts=3
# TrainingExports__RetryBaseDelaySeconds=60
# TrainingExports__RunLeaseMinutes=30
# TrainingExports__ReadBatchSize=500
# TrainingExports__MaxRangeDays=366
# TrainingExports__ListMaxPageSize=50
# TrainingExports__RetentionDays=7
# TrainingExports__RetentionSweepEnabled=true
# TrainingExports__RetentionSweepIntervalSeconds=3600
# TrainingExports__RetentionSweepBatchSize=20

# Admin dashboard (docs/dashboard.md). Defaults suit every host; TimeZone must be an IANA id and DefaultRangeDays must not exceed MaxRangeDays, or the API does not start.
# Dashboard__TimeZone=Africa/Cairo
# Dashboard__CacheSeconds=60
# Dashboard__DefaultRangeDays=30
# Dashboard__MaxRangeDays=366
# Dashboard__RecentWeekDays=7
# Dashboard__RecentMonthDays=30

# Object storage (docs/deployment.md, Object storage). Local (the api-media volume) is the default; S3 uses a private R2 or AWS S3 bucket.
# FileStorage__Provider=S3
# FileStorage__S3ServiceUrl=https://<account>.r2.cloudflarestorage.com
# FileStorage__S3Region=auto
# FileStorage__S3BucketName=
# FileStorage__S3AccessKeyId=
# FileStorage__S3SecretAccessKey=
# FileStorage__S3ForcePathStyle=true

# Observability (docs/observability.md). OTLP_ENDPOINT in .env switches export on; headers only for a SaaS endpoint (secret).
# Observability__OtlpHeaders=authorization=Bearer <token>
# Observability__TraceSampleRatio=1.0
# ClientErrors__PermitLimit=30

# Load-test seed (docs/performance.md §5). Only deploy/load-test.sh sets these, on its throwaway stack; the seed refuses Production.
# LoadTestSeed__Key=loadtest
# LoadTestSeed__StudentCount=60
# LoadTestSeed__StudentPassword=

# Set by compose, do not add here: ASPNETCORE_ENVIRONMENT, ConnectionStrings__DbConnectionString, ReverseProxy__TrustedNetworks__0, AiService__BaseUrl, FileStorage__LocalRootPath, FileStorage__PublicBaseUrl, Observability__OtlpEndpoint, Observability__ServiceVersion, CoreLogging__Console__Format
