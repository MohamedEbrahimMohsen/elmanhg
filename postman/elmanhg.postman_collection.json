            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{otpCode}}\",\n  \"verificationId\": \"{{verificationId}}\"\n}",
              "options": { "raw": { "language": "json" } }
