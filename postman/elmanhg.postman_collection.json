{
  "info": {
    "name": "Elmanhg",
    "description": "Mirrors the API surface. Every endpoint added, changed, or removed updates this collection in the same change.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5080" },
    { "key": "accessToken", "value": "" },
    { "key": "phoneNumber", "value": "01012345678" },
    { "key": "verificationId", "value": "" },
    { "key": "otpCode", "value": "" },
    { "key": "teacherId", "value": "" },
    { "key": "subjectId", "value": "" },
    { "key": "unitId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"body is Healthy\", function () { pm.expect(pm.response.text()).to.eql(\"Healthy\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      },
      "response": []
    },
    {
      "name": "Auth",
      "description": "Refresh token travels only in the HttpOnly elmanhg_refresh cookie (Path=/api/auth). The OTP code is logged by FakeSmsSender in the API console; paste it into otpCode.",
      "item": [
        {
          "name": "SendOtp",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"verificationId\", pm.response.json().verificationId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/otp/send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "otp", "send"]
            },
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        },
        {
          "name": "VerifyOtp",
