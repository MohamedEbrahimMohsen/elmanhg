{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin --delete*)",
      "Bash(git push origin :*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -x*)",
      "Bash(git clean -fdx*)",
      "Bash(git branch -D*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git config --global*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo rename*)",
      "Bash(gh release delete*)",
      "Bash(gh secret*)",
      "Bash(gh auth*)",
      "Bash(gh ssh-key*)",
      "Bash(gh gpg-key*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf .git*)",
      "Bash(rm -rf ..*)",
      "Bash(sudo *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(npm publish*)",
      "Bash(dotnet nuget push*)",
      "Bash(twine upload*)",
      "Bash(docker system prune*)",
      "Bash(docker volume prune*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.prod)",
      "Read(./.env.staging)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Read(~/.nuget/NuGet/NuGet.Config)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(**/.env)",
      "Edit(./.claude/pipeline.local.yml)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.process/autopilot/**)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push -u origin*)",
      "Bash(git push origin feature/*)",
      "Bash(git push origin revert/*)",
      "Bash(git stash*)",
      "Bash(git revert*)",
      "Bash(git merge-base*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git ls-remote*)",
      "Bash(git hash-object*)",
      "Bash(gh issue*)",
      "Bash(gh pr*)",
      "Bash(gh run*)",
      "Bash(gh label*)",
      "Bash(gh api*)",
      "Bash(gh repo view*)",
      "Bash(dotnet *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(pytest*)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(./gradlew *)",
      "Bash(docker compose*)",
      "Bash(./init.sh*)",
      "Bash(scripts/verify.sh*)",
      "Bash(./scripts/verify.sh*)",
      "Bash(gitleaks *)",
      "Bash(semgrep *)",
      "Bash(osv-scanner *)",
      "Bash(pip-audit *)",
      "Bash(opencode *)",
      "Bash(agy *)",
      "Bash(curl -fsS http://localhost*)",
      "Bash(curl -s http://localhost*)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1200000"
  }
}
