# Copy to .env.local (gitignored). Every VITE_* value ships to the browser: never put secrets here.
# Absolute API origin; empty = same origin (dev server proxies /api).
VITE_API_BASE_URL=
# student | teacher | admin signs the stub session in at startup until real sign-in (#56). Empty = signed out.
VITE_DEV_SESSION_ROLE=student
# Dev-server proxy target for /api (read by vite.config.ts only, not shipped).
API_PROXY_TARGET=http://localhost:5080
