  "components": {
    "schemas": {
      "AnswerForm": {
        "type": "string",
        "enum": [
          "equivalent",
          "simplified",
          "factored",
          "expanded",
          "exact"
        ],
        "title": "AnswerForm"
      },
      "AudioContentType": {
        "type": "string",
        "enum": [
          "audio/webm",
          "audio/ogg",
          "audio/mp4"
        ],
        "title": "AudioContentType"
      },
      "ChatEntryPoint": {
        "type": "string",
        "enum": [
          "lesson",
          "quizQuestion",
          "examReview",
          "global"
        ],
        "title": "ChatEntryPoint"
      },
      "ChatIn": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/ContextBundleIn"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageIn"
            },
            "type": "array",
            "title": "History"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/ChatSourceIn"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "context",
          "message"
        ],
        "title": "ChatIn"
      },
      "ChatMessageIn": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/ChatRole"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessageIn"
      },
      "ChatOut": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "promptVersion": {
            "type": "string",
            "title": "Promptversion"
          },
          "inputTokens": {
            "type": "integer",
            "title": "Inputtokens"
          },
          "outputTokens": {
            "type": "integer",
            "title": "Outputtokens"
          },
          "stopReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stopreason"
          },
          "costUsd": {
            "type": "number",
            "title": "Costusd"
          },
          "citations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citations"
          }
        },
        "type": "object",
        "required": [
          "reply",
          "model",
          "promptVersion",
          "inputTokens",
          "outputTokens",
          "stopReason",
          "costUsd",
          "citations"
        ],
        "title": "ChatOut"
      },
      "ChatRole": {
        "type": "string",
        "enum": [
          "user",
          "assistant"
        ],
        "title": "ChatRole"
      },
      "ChatSourceIn": {
        "properties": {
          "reference": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$",
            "title": "Reference"
          },
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Title"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reference",
          "title",
          "content"
        ],
        "title": "ChatSourceIn"
      },
      "ContextBundleIn": {
        "properties": {
          "entryPoint": {
            "$ref": "#/components/schemas/ChatEntryPoint"
          },
          "subject": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ContextRefIn"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ContextRefIn"
              },
              {
                "type": "null"
              }
            ]
          },
          "lesson": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LessonContextIn"
              },
              {
                "type": "null"
              }
            ]
          },
          "question": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QuestionContextIn"
              },
              {
                "type": "null"
              }
            ]
          },
          "subjects": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Subjects"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "entryPoint"
        ],
        "title": "ContextBundleIn"
      },
      "ContextRefIn": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "ContextRefIn"
      },
      "CriterionGradeOut": {
        "properties": {
          "criterionId": {
            "type": "string",
            "title": "Criterionid"
          },
          "points": {
            "type": "integer",
            "title": "Points"
          },
          "justification": {
            "type": "string",
            "title": "Justification"
          }
        },
        "type": "object",
        "required": [
          "criterionId",
          "points",
          "justification"
        ],
        "title": "CriterionGradeOut"
      },
      "EmbeddingInputType": {
        "type": "string",
        "enum": [
          "document",
          "query"
        ],
        "title": "EmbeddingInputType"
      },
      "EmbeddingsIn": {
        "properties": {
          "inputType": {
            "$ref": "#/components/schemas/EmbeddingInputType"
          },
          "texts": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "minItems": 1,
            "title": "Texts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "inputType",
          "texts"
        ],
        "title": "EmbeddingsIn"
      },
      "EmbeddingsOut": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model"
          },
          "dimensions": {
            "type": "integer",
            "title": "Dimensions"
          },
          "embeddings": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Embeddings"
          },
          "inputTokens": {
            "type": "integer",
            "title": "Inputtokens"
          }
        },
        "type": "object",
        "required": [
          "model",
          "dimensions",
          "embeddings",
          "inputTokens"
        ],
        "title": "EmbeddingsOut"
      },
      "EssayGradeIn": {
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "title": "Question"
          },
          "criteria": {
            "items": {
              "$ref": "#/components/schemas/RubricCriterionIn"
            },
            "type": "array",
            "minItems": 1,
            "title": "Criteria"
          },
          "modelAnswers": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "minItems": 1,
            "title": "Modelanswers"
          },
          "essay": {
            "type": "string",
            "minLength": 1,
            "title": "Essay"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject"
          },
          "objectives": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Objectives"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question",
          "criteria",
          "modelAnswers",
          "essay"
        ],
        "title": "EssayGradeIn"
      },
      "EssayGradeOut": {
        "properties": {
          "criteria": {
            "items": {
              "$ref": "#/components/schemas/CriterionGradeOut"
            },
            "type": "array",
            "title": "Criteria"
          },
          "totalPoints": {
            "type": "integer",
            "title": "Totalpoints"
          },
          "maxPoints": {
            "type": "integer",
            "title": "Maxpoints"
          },
          "justification": {
            "type": "string",
            "title": "Justification"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "promptVersion": {
            "type": "string",
            "title": "Promptversion"
          },
          "inputTokens": {
            "type": "integer",
            "title": "Inputtokens"
          },
          "outputTokens": {
            "type": "integer",
            "title": "Outputtokens"
          },
          "stopReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stopreason"
          },
          "costUsd": {
            "type": "number",
            "title": "Costusd"
          }
        },
        "type": "object",
        "required": [
          "criteria",
          "totalPoints",
          "maxPoints",
          "justification",
          "confidence",
          "model",
          "promptVersion",
          "inputTokens",
          "outputTokens",
          "stopReason",
          "costUsd"
        ],
        "title": "EssayGradeOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LessonContextIn": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation",
            "default": ""
          },
          "objectives": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Objectives"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "LessonContextIn"
      },
      "MathCheckIn": {
        "properties": {
          "answer": {
            "type": "string",
            "minLength": 1,
            "title": "Answer"
          },
          "expected": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "minItems": 1,
            "title": "Expected"
          },
          "form": {
            "$ref": "#/components/schemas/AnswerForm",
            "default": "equivalent"
          },
          "tolerance": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tolerance"
          },
          "toleranceMode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ToleranceMode"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answer",
          "expected"
        ],
        "title": "MathCheckIn"
      },
      "MathCheckOut": {
        "properties": {
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          },
          "matchedIndex": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matchedindex"
          },
          "invalidExpected": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Invalidexpected"
          }
        },
        "type": "object",
        "required": [
          "verdict",
          "matchedIndex",
          "invalidExpected"
        ],
        "title": "MathCheckOut"
      },
      "MathStepGradeIn": {
        "properties": {
