{
  "openapi": "3.1.0",
  "info": {
    "title": "Elmanhg AI service",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Create Chat Reply",
        "operationId": "chat_create_chat_reply",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatOut"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/embeddings": {
      "post": {
        "tags": [
          "embeddings"
        ],
        "summary": "Create Embeddings",
        "operationId": "embeddings_create_embeddings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbeddingsIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingsOut"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/transcriptions": {
      "post": {
        "tags": [
          "transcriptions"
        ],
        "summary": "Create Transcription",
        "operationId": "transcriptions_create_transcription",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranscriptionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptionOut"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AudioContentType": {
        "type": "string",
        "enum": [
          "audio/webm",
          "audio/ogg",
          "audio/mp4"
        ],
        "title": "AudioContentType"
      },
      "ChatEntryPoint": {
        "type": "string",
        "enum": [
          "lesson",
          "quizQuestion",
          "examReview",
          "global"
        ],
        "title": "ChatEntryPoint"
      },
      "ChatIn": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/ContextBundleIn"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageIn"
            },
            "type": "array",
            "title": "History"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/ChatSourceIn"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "context",
          "message"
        ],
        "title": "ChatIn"
      },
      "ChatMessageIn": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/ChatRole"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessageIn"
      },
      "ChatOut": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "promptVersion": {
            "type": "string",
            "title": "Promptversion"
          },
          "inputTokens": {
            "type": "integer",
            "title": "Inputtokens"
          },
          "outputTokens": {
            "type": "integer",
            "title": "Outputtokens"
          },
          "stopReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stopreason"
          },
          "citations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citations"
          }
        },
        "type": "object",
        "required": [
          "reply",
          "model",
          "promptVersion",
          "inputTokens",
          "outputTokens",
          "stopReason",
          "citations"
        ],
        "title": "ChatOut"
      },
      "ChatRole": {
        "type": "string",
        "enum": [
          "user",
          "assistant"
        ],
        "title": "ChatRole"
      },
      "ChatSourceIn": {
        "properties": {
          "reference": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[a-z0-9-]+$",
            "title": "Reference"
          },
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Title"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reference",
          "title",
          "content"
        ],
        "title": "ChatSourceIn"
      },
      "ContextBundleIn": {
        "properties": {
          "entryPoint": {
            "$ref": "#/components/schemas/ChatEntryPoint"
          },
          "subject": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ContextRefIn"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ContextRefIn"
              },
              {
                "type": "null"
              }
            ]
          },
          "lesson": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LessonContextIn"
              },
              {
                "type": "null"
              }
            ]
          },
          "question": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QuestionContextIn"
              },
              {
                "type": "null"
              }
            ]
          },
          "subjects": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Subjects"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "entryPoint"
        ],
        "title": "ContextBundleIn"
      },
      "ContextRefIn": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "ContextRefIn"
      },
      "EmbeddingInputType": {
        "type": "string",
        "enum": [
          "document",
          "query"
        ],
        "title": "EmbeddingInputType"
      },
      "EmbeddingsIn": {
        "properties": {
          "inputType": {
            "$ref": "#/components/schemas/EmbeddingInputType"
          },
          "texts": {
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array",
            "minItems": 1,
            "title": "Texts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "inputType",
          "texts"
        ],
        "title": "EmbeddingsIn"
      },
      "EmbeddingsOut": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model"
          },
          "dimensions": {
            "type": "integer",
            "title": "Dimensions"
          },
          "embeddings": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Embeddings"
          },
          "inputTokens": {
            "type": "integer",
            "title": "Inputtokens"
          }
        },
        "type": "object",
        "required": [
          "model",
          "dimensions",
          "embeddings",
          "inputTokens"
        ],
        "title": "EmbeddingsOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LessonContextIn": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation",
            "default": ""
          },
          "objectives": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Objectives"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "LessonContextIn"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "instance": {
            "type": "string",
            "title": "Instance"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "traceId": {
            "type": "string",
            "title": "Traceid"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ProblemFieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "instance",
          "code",
          "traceId"
        ],
        "title": "Problem"
      },
      "ProblemFieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "ProblemFieldError"
      },
      "QuestionContextIn": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "stem": {
            "type": "string",
            "minLength": 1,
            "title": "Stem"
          },
          "studentAnswer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Studentanswer"
          },
          "correctAnswer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correctanswer"
          },
          "explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "stem"
        ],
        "title": "QuestionContextIn"
      },
      "TranscriptionIn": {
        "properties": {
          "audio": {
            "type": "string",
            "format": "base64",
            "contentMediaType": "application/octet-stream",
            "title": "Audio"
          },
          "contentType": {
            "$ref": "#/components/schemas/AudioContentType"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}$",
            "title": "Language",
            "default": "ar"
          },
          "durationSeconds": {
            "type": "integer",
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Durationseconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "audio",
          "contentType",
          "durationSeconds"
        ],
        "title": "TranscriptionIn"
      },
      "TranscriptionOut": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "language": {
            "type": "string",
            "title": "Language"
          }
        },
        "type": "object",
        "required": [
          "text",
          "model",
          "language"
        ],
        "title": "TranscriptionOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
