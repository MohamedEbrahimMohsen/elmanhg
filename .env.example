# Copy to .env (gitignored). Read by docker compose and, in Development, by Elmanhg.Api.
POSTGRES_DB=elmanhg
POSTGRES_USER=elmanhg
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
ConnectionStrings__DbConnectionString='Host=localhost;Port=5432;Database=elmanhg;Username=elmanhg;Password=change-me-local-only'
CoreJwt__Issuer=Elmanhg
CoreJwt__Audience=Elmanhg.Audience
CoreJwt__Key=change-me-generate-a-unique-signing-key-of-at-least-32-bytes
CoreOtp__Secret=change-me-local-otp-hmac-secret
AdminSeed__Email=admin@elmanhg.local
AdminSeed__Password=change-me-Admin1
AdminSeed__DisplayName=Admin
# OTP delivery (docs/otp-delivery.md). Fakes are the default; set a real provider and its keys to go live.
# OtpDelivery__WhatsApp__Provider=Meta
# OtpDelivery__WhatsApp__PhoneNumberId=
# OtpDelivery__WhatsApp__AccessToken=
# OtpDelivery__WhatsApp__TemplateName=
# OtpDelivery__Email__Provider=Resend
# OtpDelivery__Email__ApiKey=
# OtpDelivery__Email__FromAddress=
# OtpDelivery__Sms__Enabled=true
# OtpDelivery__Sms__Provider=Http
# OtpDelivery__Sms__Url=
# OtpDelivery__Sms__AuthHeaderName=
# OtpDelivery__Sms__AuthHeaderValue=
# OtpDelivery__Sms__BodyTemplate=
# Payments (docs/paymob.md). Fake is the default; set Paymob and its keys to go live.
# Payments__Provider=Paymob
# Payments__Paymob__SecretKey=
# Payments__Paymob__PublicKey=
# Payments__Paymob__IntegrationIds__0=
# Payments__Paymob__IntegrationIds__1=
# Payments__Paymob__RedirectionUrl=
# Payments__Paymob__NotificationUrl=
# Payments__Paymob__HmacSecret=
