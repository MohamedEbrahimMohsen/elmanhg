# Copy to .env (gitignored). Read by docker compose and, in Development, by Elmanhg.Api.
POSTGRES_DB=elmanhg
POSTGRES_USER=elmanhg
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
ConnectionStrings__DbConnectionString='Host=localhost;Port=5432;Database=elmanhg;Username=elmanhg;Password=change-me-local-only'
CoreJwt__Issuer=Elmanhg
CoreJwt__Audience=Elmanhg.Audience
CoreJwt__Key=change-me-generate-a-unique-signing-key-of-at-least-32-bytes
CoreOtp__Secret=change-me-local-otp-hmac-secret
AdminSeed__Email=admin@elmanhg.local
AdminSeed__Password=change-me-Admin1
AdminSeed__DisplayName=Admin
# OTP delivery (docs/otp-delivery.md). Fakes are the default; set a real provider and its keys to go live.
# OtpDelivery__WhatsApp__Provider=Meta
# OtpDelivery__WhatsApp__PhoneNumberId=
# OtpDelivery__WhatsApp__AccessToken=
# OtpDelivery__WhatsApp__TemplateName=
# OtpDelivery__Email__Provider=Resend
# OtpDelivery__Email__ApiKey=
# OtpDelivery__Email__FromAddress=
# OtpDelivery__Sms__Enabled=true
# OtpDelivery__Sms__Provider=Http
# OtpDelivery__Sms__Url=
# OtpDelivery__Sms__AuthHeaderName=
# OtpDelivery__Sms__AuthHeaderValue=
# OtpDelivery__Sms__BodyTemplate=
# Payments (docs/paymob.md). Fake is the default; set Paymob and its keys to go live.
# Payments__Provider=Paymob
# Payments__Paymob__SecretKey=
# Payments__Paymob__PublicKey=
# Payments__Paymob__IntegrationIds__0=
# Payments__Paymob__IntegrationIds__1=
# Payments__Paymob__RedirectionUrl=
# Payments__Paymob__NotificationUrl=
# Payments__Paymob__HmacSecret=
# Payments__AllowFakePayments=false   # unset = true in Development (this file); never true in Production
# AI service (docs/ai-service.md). The API uses a fake assistant by default; set AiService__Provider=Http to call the Python service.
# Both lines hold the same shared token (at least 32 characters): the API sends it, the AI service checks it.
AiService__ServiceToken=change-me-local-ai-service-token-0123456789
ELMANHG_AI_SERVICE_TOKEN=change-me-local-ai-service-token-0123456789
# AiService__Provider=Http
# AiService__BaseUrl=http://localhost:8000
# AI_PORT=8000
# LLM: any OpenAI-compatible Chat Completions API (OpenAI by default; Gemini or DeepSeek by base URL). Fake is the default.
# The model id and prices are placeholders: confirm them against the provider's model list at go-live (docs/ai-service.md).
# ELMANHG_AI_LLM_PROVIDER=openai_compatible
# ELMANHG_AI_LLM_BASE_URL=https://api.openai.com/v1
# ELMANHG_AI_LLM_API_KEY=            # empty: reuse ELMANHG_AI_OPENAI_API_KEY
# ELMANHG_AI_CHAT_MODEL=gpt-5.6-luna
# ELMANHG_AI_LLM_STRUCTURED_OUTPUT=json_schema   # json_object for DeepSeek
# ELMANHG_AI_LLM_MAX_TOKENS_FIELD=max_completion_tokens   # max_tokens for DeepSeek
# ELMANHG_AI_LLM_REASONING_EFFORT=low   # default = do not send
# ELMANHG_AI_MODEL_INPUT_USD_PER_MILLION_TOKENS=0.20
# ELMANHG_AI_MODEL_OUTPUT_USD_PER_MILLION_TOKENS=1.20
# AI Avatar (docs/avatar.md): the production prompt is v3; the API caps a student message at Avatar__MessageMaxLength characters.
# ELMANHG_AI_CHAT_PROMPT_VERSION=v3
# Avatar__MessageMaxLength=2000
# Lesson retrieval embeddings (docs/content-retrieval.md). Fake is the default; set openai and a key to go live, then POST /api/content-index/rebuild.
# ELMANHG_AI_EMBEDDING_PROVIDER=openai
# ELMANHG_AI_OPENAI_API_KEY=
# ELMANHG_AI_EMBEDDING_MODEL=text-embedding-3-small
# ContentRetrieval__IndexSweepEnabled=true
# Ask a Teacher (docs/ask-teacher.md). Defaults suit local dev; photos are private files under App_Data/media/teacher-threads.
# AskTeacher__ImageMaxSizeInMb=5
# Voice replies are transcribed by the API's worker through the ai service (fake by default).
# AskTeacher__VoiceMaxDurationSeconds=180
# ELMANHG_AI_TRANSCRIPTION_PROVIDER=openai
# ELMANHG_AI_TRANSCRIPTION_MODEL=whisper-1
# Essay grading (#118, docs/essay-grading.md). The API grades essays in a background worker through the ai service (fake by default).
# ELMANHG_AI_ESSAY_GRADING_MODEL=gpt-5.6-luna
# ELMANHG_AI_ESSAY_GRADING_TIMEOUT_SECONDS=45
# EssayGrading__SweepEnabled=true
# EssayGrading__ReviewConfidenceThreshold=0.7
# AiService__EssayGradingTimeoutSeconds=100
# #122 CAS final answer check (docs/math-cas.md). SymPy runs in the ai service; the API defers the answer and retries in the background when it is down.
# ELMANHG_AI_CAS_TIMEOUT_SECONDS=5
# ELMANHG_AI_CAS_WORKERS=2
# ELMANHG_AI_CAS_WORKER_MEMORY_MB=1024
# ELMANHG_AI_CAS_MAX_EXPANSION_TERMS=500
# AiService__MathCheckTimeoutSeconds=15
# Math step grading (#123, docs/math-step-grading.md). The API grades MathSteps working in a background worker through the ai service (fake by default).
# ELMANHG_AI_MATH_STEP_GRADING_MODEL=gpt-5.6-luna
# ELMANHG_AI_MATH_STEP_GRADING_TIMEOUT_SECONDS=45
# MathStepGrading__SweepEnabled=true
# MathStepGrading__ReviewConfidenceThreshold=0.7
# MathStepGrading__CheckPermitLimit=10
# AiService__MathStepGradingTimeoutSeconds=100
# Admin Configuration page (docs/configuration.md §6): the AI service status probe gives up after this many seconds and shows "unreachable".
# AiService__ConfigurationTimeoutSeconds=5
# Object storage (docs/deployment.md, Object storage). Local disk is the default; set S3 and the keys for R2 or AWS S3.
# FileStorage__Provider=S3
# FileStorage__S3ServiceUrl=
# FileStorage__S3Region=auto
# FileStorage__S3BucketName=
# FileStorage__S3AccessKeyId=
# FileStorage__S3SecretAccessKey=
# Production and staging: see docs/deployment.md (deploy/*.env.example).
